# ============================================================
# BACKEND RUNTIME
# ============================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ============================================================
# DATABASE / MONGOOSE
# ============================================================
MONGO_URI=mongodb://127.0.0.1:27017/online_store
TEST_MONGO_URI=mongodb://127.0.0.1:27017/online_store_test
MONGO_DNS_SERVERS=
DB_OPERATION_TIMEOUT=120000

# ============================================================
# EXTERNAL SERVICES
# ============================================================
EXCHANGE_RATE_API=

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# ============================================================
# ADMIN AUTHENTICATION FOR INTEGRATION TESTS
# By default the harness creates a unique admin fixture in the isolated test DB,
# logs in with an in-memory password, then removes the fixture during cleanup.
# Set these only to override credentials for an existing test backend.
# Application users, roles and preferences belong in MongoDB per user.
# ============================================================
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# Use only when an isolated test backend already has a valid token.
# TEST_ADMIN_TOKEN=

# ============================================================
# CLOUDINARY
# API secret must remain backend-only. Add account groups as _3, _4, ...
# ============================================================
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# CLOUDINARY_CLOUD_NAME_2=
# CLOUDINARY_API_KEY_2=
# CLOUDINARY_API_SECRET_2=
# CLOUDINARY_CLOUD_NAME_3=
# CLOUDINARY_API_KEY_3=
# CLOUDINARY_API_SECRET_3=

# Optional source asset used by about-media seeding.
# ABOUT_HERO_SOURCE=

# ============================================================
# VNPAY
# ============================================================
VNPAY_TMN_CODE=replace-with-tmn-code
VNPAY_HASH_SECRET=replace-with-hash-secret
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result
VNPAY_CALLBACK_URL=http://localhost:5000/api/payments/webhook/vnpay

# ============================================================
# GHN SHIPPING
# ============================================================
GHN_API_TOKEN=replace-with-ghn-api-token
GHN_SHOP_ID=replace-with-ghn-shop-id
GHN_MAX_INSURANCE_VALUE=5000000

# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL_DEV=http://localhost:5000/api/users/auth/google/callback
GOOGLE_CALLBACK_URL_PROD=https://backend.manln.online/api/users/auth/google/callback

# ============================================================
# EMAIL / SMTP
# ============================================================
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Use when EMAIL_SERVICE=sendgrid.
SENDGRID_API_KEY=

# ============================================================
# CLOUDFLARE AI TRANSLATION
# Numbered groups are recommended for multiple accounts.
# ============================================================
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_AI_MODEL_1=@cf/meta/llama-3-8b-instruct
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_TOKEN_2=
# CLOUDFLARE_AI_MODEL_2=@cf/meta/llama-3-8b-instruct
CLOUDFLARE_MAX_REQUESTS_PER_SEC=5
# Optional single-account names when numbered groups are not used.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct

# ============================================================
# REDIS / DISTRIBUTED LOCK
# ============================================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
# Set to memory only for local/test mode when Redis is intentionally unavailable.
# PRODUCT_SEED_LOCK_MODE=memory

# ============================================================
# EXPORT STORAGE
# ============================================================
EXPORT_STORAGE=local
EXPORT_JOB_DIR=.test-export-jobs
EXPORT_DEBUG=false
EXPORT_DEBUG_IMAGES=false
EXPORT_QUERY_TIMEOUT_MS=120000
EXPORT_LOCALES=vi,en
EXPORT_TRANSLATION_FALLBACKS={}
MAX_ACTIVE_EXPORT_JOBS_PER_USER=2
MAX_ACTIVE_EXPORT_JOBS_GLOBAL=8

# Set EXPORT_STORAGE=s3 to use object storage.
# EXPORT_S3_BUCKET=
# EXPORT_S3_REGION=
# EXPORT_S3_PREFIX=exports
# EXPORT_S3_ENDPOINT=
# EXPORT_S3_FORCE_PATH_STYLE=false
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ============================================================
# EXPORT / E2E LOGIN TESTS
# ============================================================
EXPORT_FRONTEND_BASE_URL=http://localhost:3000
EXPORT_BACKEND_BASE_URL=http://localhost:5000
EXPORT_TEST_EMAIL=
EXPORT_TEST_PASSWORD=
# EXPORT_CREDENTIAL_PATH=

# ============================================================
# TRANSLATION / SEED OPTIONS
# ============================================================
TRANSLATION_LEGACY_FALLBACK=true
TRANSLATION_MAX_RETRIES=2
TRANSLATION_RETRY_DELAY_MS=1000
TRANSLATION_TIMEOUT_MS=30000
USE_NEW_SCHEMA=true
SHADOW_WRITES_ENABLED=true
DRY_RUN=false
INCREMENTAL_SEED=false
SCRAPER_OUTPUT_DIR=
PYTHON_COMMAND=python
SEED_INITIAL_STOCK=

# ============================================================
# EXPORT IMAGE SECURITY
# ============================================================
ENFORCE_EXPORT_IMAGE_DNS_SECURITY=false

# ============================================================
# TEST RUNNER
# ============================================================
TEST_BASE_URL=http://127.0.0.1:5000
TEST_API_BASE_URL=http://127.0.0.1:5000
TEST_FRONTEND_ROOT=
TEST_LANGUAGE_CODE=fr
TEST_TIMEOUT_MS=30000
TEST_BACKGROUND_TIMEOUT_MS=60000
RUN_INTEGRATION_TESTS=false
# Compatibility aliases used by older test scripts.
# BASE_URL=http://127.0.0.1:5000
# API_BASE_URL=http://127.0.0.1:5000
