# Cloudflare R2 (S3-compatible)
# Product scraper timing and concurrency
SCRAPER_REQUEST_TIMEOUT_SECONDS=8
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_BACKOFF_SECONDS=1
SCRAPER_DYNAMIC_RENDER_TIMEOUT_SECONDS=45
SCRAPER_NAVIGATION_TIMEOUT_MS=15000
SCRAPER_DOMCONTENTLOADED_TIMEOUT_MS=3000
SCRAPER_SELECTOR_TIMEOUT_MS=7000
SCRAPER_EXPANDABLE_CLICK_TIMEOUT_MS=2000
SCRAPER_EXPANDABLE_SETTLE_MS=300
SCRAPER_IMAGE_CONNECT_TIMEOUT_SECONDS=8
SCRAPER_IMAGE_READ_TIMEOUT_SECONDS=20
SCRAPER_IMAGE_RETRY_ATTEMPTS=3
SCRAPER_IMAGE_RETRY_BACKOFF_SECONDS=1
SCRAPER_MAX_WORKERS=4

# Cloudflare R2 account 1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Backend-only upload guard. Keep false until free-tier budget is reviewed.
R2_UPLOAD_ENABLED=false
R2_MAX_UPLOAD_COUNT=0
R2_MAX_UPLOAD_BYTES=0
R2_MAX_IMAGE_BYTES=5242880
R2_MAX_VIDEO_BYTES=5242880
R2_MAX_RETRIES=2

# Cloudflare AI backend-only guard. Cloudflare is required for final translations.
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_AI_MAX_REQUESTS_PER_DAY=0
CLOUDFLARE_AI_MAX_INPUT_CHARS_PER_DAY=0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
CLOUDFLARE_MAX_REQUESTS_PER_SEC=5

# Optional product translation provider. Cloudflare remains primary by default.
LIBRETRANSLATE_ENABLED=false
LIBRETRANSLATE_FAILOVER_ON_CLOUDFLARE_OVERLOAD=false
LIBRETRANSLATE_AS_PRIMARY_APPROVED=false
LIBRETRANSLATE_URL=http://127.0.0.1:5001
LIBRETRANSLATE_TIMEOUT_MS=30000
LIBRETRANSLATE_RETRIES=2
LIBRETRANSLATE_RETRY_DELAY_MS=1000
LIBRETRANSLATE_MAX_PARALLEL_REQUESTS=4
LIBRETRANSLATE_DESCRIPTION_CHUNK_SIZE=6000
LIBRETRANSLATE_API_KEY=

# Product translation rollout. Limit to a priority batch before full translation.
# 0 = all active products; values above 0 select featured/newest products first.
PRODUCT_TRANSLATION_LIMIT=0
# Rollout level 1: tăng nhẹ sau khi fallback đã được kiểm tra.
PRODUCT_TRANSLATION_CHUNK_SIZE=20
PRODUCT_TRANSLATION_CONCURRENCY=2
# Giữ 1 nếu chưa benchmark quota tổng; rollout mẫu dùng 2 ngôn ngữ/lần.
PRODUCT_TRANSLATION_LANGUAGE_CONCURRENCY=2
PRODUCT_TRANSLATION_DELAY_MS=300
PRODUCT_TRANSLATION_MEMORY_CACHE_SIZE=5000
PRODUCT_TRANSLATION_LOCK_TTL_SECONDS=120

# Optional backend-only role routing; otherwise a stable hash selects the account.
# R2_ACCOUNT_ROLE_PRODUCT=1
# R2_ACCOUNT_ROLE_AVATAR=1
# R2_ACCOUNT_ROLE_REVIEW=1
# R2_ACCOUNT_ROLE_BANNER=1

# Cloudflare R2 accounts 2-9
R2_ACCOUNT_ID_2=
R2_ACCESS_KEY_ID_2=
R2_SECRET_ACCESS_KEY_2=
R2_BUCKET_NAME_2=
R2_PUBLIC_BASE_URL_2=

