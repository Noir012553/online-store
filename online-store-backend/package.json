  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "archiver": "^8.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
