{
  "name": "laptop-store-backend",
  "version": "1.0.0",
  "description": "Backend for Laptop Store Application",
  "main": "src/app.js",
  "scripts": {
    "start": "node --max-old-space-size=1024 src/app.js",
    "dev": "nodemon src/app.js",
    "tunnel": "node scripts/tunnel.js",
    "test": "node src/test/test-runner.js --suite=products",
    "test:all": "node src/test/test-runner.js",
    "test:integration": "node src/test/test-runner.js -- --suite=backend",
    "test:integration:import-export": "node src/test/test-runner.js -- --suite=import-export",
    "test:offline": "node src/test/frontend-offline-manual.test.js",
    "test:export:dynamic": "node scripts/test-export-dynamic.js",
    "test:export:production": "node src/test/export-production.test.js",
    "test:import:export:dynamic": "node src/test/import-export.test.js",
    "test:import:export:dynamic:local": "node src/test/import-export.test.js --environment local --target frontend --format json --mode upsert --limit 10",
    "test:import:export:dynamic:local:backend": "node src/test/import-export.test.js --environment local --target backend --format json --mode upsert --limit 10",
    "check:emoji": "node scripts/check-cli-symbols.js",
    "test:list": "node src/test/test-runner.js -- --list",
    "test:simple": "node src/test/simple.test.js",
    "test:vnpay": "node src/test/vnpay-quick.test.js",
    "test:vnpay:watch": "nodemon src/test/vnpay-quick.test.js",
    "test:vnpay:signature": "node src/test/vnpay-signature-fix.test.js",
    "test:flow": "node src/test/with-order.test.js",
    "seed": "node --expose-gc src/seeds/index.js",
    "seed:shutdown": "powershell -NoProfile -Command \"npm run seed; if ($?) { shutdown /s /t 60 }\"",
    "seed:refresh:shutdown": "powershell -NoProfile -Command \"npm run seed -- --force-scrape; if ($?) { shutdown /s /t 60 }\"",
    "seed:list": "node --expose-gc src/seeds/index.js -- --list",
    "seed:modules": "node --expose-gc src/seeds/index.js -- --modules",
    "seed:only": "node --expose-gc src/seeds/index.js -- --only-module",
    "seed:spec-key-cache": "node --expose-gc src/seeds/index.js -- --only-module=specKeyCache",
    "audit:spec-key-cache": "node src/scripts/audit-spec-key-cache.js",
    "migrate:spec-key-cache": "node src/scripts/migrate-spec-key-cache.js",
    "backup:spec-key-cache": "node scripts/backup-spec-key-cache.js",
    "restore:spec-key-cache": "node scripts/restore-spec-key-cache.js",
    "seed:dry-run": "DRY_RUN=true node --expose-gc src/seeds/index.js -- --dry-run",
    "seed:incremental": "INCREMENTAL_SEED=true node --expose-gc src/seeds/index.js -- --incremental",
    "seed:i18n": "node --expose-gc src/seeds/index.js -- --i18n-only",
    "seed:pre-products": "node --expose-gc src/seeds/index.js -- --phase=pre-products",
    "seed:post-products": "node --expose-gc src/seeds/index.js -- --phase=post-products",
    "seed:about-media": "node src/scripts/seed-about-media.js",
    "seed:loading-media": "node src/scripts/seed-loading-media.js",
    "seed:with-dashboard-data": "npm run seed && npm run indexes:dashboard:apply && npm run check:dashboard-data",
    "media:upload": "node src/scripts/upload-scraped-images.js",
    "test:ghn-ward": "node scripts/test-ghn-ward.js",
    "cleanup:inventory": "node src/scripts/inventory-product-cleanup.js",
    "cleanup:execute": "node src/scripts/execute-product-cleanup.js",
    "seed:smart": "node src/scripts/seed-with-version-control.js",
    "check:dashboard-data": "node scripts/check-dashboard-data.js",
    "rollback:dashboard-legacy": "node scripts/check-dashboard-data.js --rollback --apply --confirm=ROLLBACK_DASHBOARD_SAMPLE",
    "indexes:dashboard": "node scripts/setup-dashboard-indexes.js",
    "indexes:dashboard:apply": "node scripts/setup-dashboard-indexes.js --apply --confirm=CREATE_DASHBOARD_INDEXES",
    "update-categories": "node src/scripts/update-categories-with-translations.js",
    "categories:sync": "node src/scripts/reseed-categories-simple.js",
    "fix:category-translations": "node src/scripts/fix-category-translations.js",
    "fix:category-translations:dry-run": "node src/scripts/fix-category-translations.js --dry-run",
    "check:sync": "node src/scripts/check-sync-status.js",
    "migrate:translations": "node src/scripts/migrate-translations.js",
    "migrate:about-media": "node src/scripts/migrate-about-media-to-r2.js",
    "inventory:legacy-assets": "node src/scripts/inventory-legacy-assets.js",
    "verify:translation-cache": "node src/scripts/migrate-translations.js --verify-only",
    "restore:translation-cache": "node scripts/restore-livetranslationcache.js",
    "check:category-references": "node src/scripts/check-category-references.js",
    "clear": "node --expose-gc src/scripts/clear-database.js",
    "fix": "node src/scripts/fix-order-customers.js",
    "setup-ghn": "node src/scripts/setup-ghn.js",
    "create-ghn": "node src/scripts/create-ghn-provider.js",
    "fix-indexes": "node src/scripts/fix-indexes.js",
    "repair:product-currencies": "node src/scripts/repair-product-currencies.js",
    "repair:product-currencies:dry-run": "node src/scripts/repair-product-currencies.js --dry-run",
    "setup-i18n-indexes": "node src/scripts/setup-production-indexes.js",
    "backfill:storefront": "node src/scripts/setup-production-indexes.js --backfill-storefront",
    "test:blueprint": "node src/test/language-setup-blueprint.test.js",
    "test:translation-quality": "node src/scripts/test-translation-quality.js",
    "check:translation-keys": "node src/scripts/verify-frontend-translation-keys.js",
    "check:translation-consistency": "node src/scripts/verify-key-consistency.js",
    "check:translation-fallback": "node src/scripts/verify-no-english-fallback.js",
    "check:language-inventory": "node src/scripts/verify-language-inventory.js --skip-database",
    "retranslate": "node src/scripts/retranslate.js",
    "translate:report": "node src/scripts/translate-report.js",
    "translate:approve": "node src/scripts/translate-approve.js",
    "translate:reject": "node src/scripts/translate-reject.js",
    "translate:approve-all": "node src/scripts/translate-approve-all.js",
    "translate:reject-all": "node src/scripts/translate-reject-all.js",
    "translate:history": "node src/scripts/translate-history.js",
    "scrape:all": "npm run scrape:laptops && npm run scrape:keyboards && npm run scrape:mice && npm run scrape:headphones",
    "scrape:laptops": "npm run scrape:acer-gaming && npm run scrape:acer-office && npm run scrape:asus-office && npm run scrape:asus-gaming && npm run scrape:dell-office && npm run scrape:gigabyte-gaming && npm run scrape:hp-gaming && npm run scrape:hp-office && npm run scrape:lenovo-gaming && npm run scrape:lenovo-office && npm run scrape:msi-gaming && npm run scrape:msi-office",
    "scrape:keyboards": "npm run scrape:asus-keyboard && npm run scrape:akko-keyboard && npm run scrape:aula-keyboard && npm run scrape:corsair-keyboard && npm run scrape:dareu-keyboard && npm run scrape:flesports-keyboard && npm run scrape:keychron-keyboard && npm run scrape:leobog-keyboard && npm run scrape:leopold-keyboard && npm run scrape:logitech-keyboard && npm run scrape:razer-keyboard",
    "scrape:mice": "npm run scrape:asus-mouse && npm run scrape:corsair-mouse && npm run scrape:dareu-mouse && npm run scrape:hyperx-mouse && npm run scrape:logitech-mouse && npm run scrape:rapoo-mouse && npm run scrape:razer-mouse",
    "scrape:headphones": "npm run scrape:asus-headphone && npm run scrape:edifier-headphone && npm run scrape:hyperx-headphone && npm run scrape:logitech-headphone && npm run scrape:razer-headphone",
    "scrape:acer-gaming": "python python/Acer_Laptop_Gaming_Scraper.py",
    "scrape:acer-office": "python python/Acer_Laptop_Office_Scraper.py",
    "scrape:asus-office": "python python/Asus_Laptop_Office_Scraper.py",
    "scrape:asus-gaming": "python python/Asus_Laptop_Gaming_Scraper.py",
    "scrape:dell-office": "python python/Dell_Laptop_Office_Scraper.py",
    "scrape:gigabyte-gaming": "python python/Gigabyte_Laptop_Gaming_Scraper.py",
    "scrape:hp-gaming": "python python/Hp_Laptop_Gaming_Scraper.py",
    "scrape:hp-office": "python python/HP_Laptop_Office_Scraper.py",
    "scrape:lenovo-gaming": "python python/Lenovo_Laptop_Gaming_Scraper.py",
    "scrape:lenovo-office": "python python/Lenovo_Laptop_Office_Scraper.py",
    "scrape:msi-gaming": "python python/Msi_Laptop_Gaming_Scraper.py",
    "scrape:msi-office": "python python/Msi_Laptop_Office_Scraper.py",
    "scrape:asus-keyboard": "python python/ASUS_Keyboard_Scraper.py",
    "scrape:akko-keyboard": "python python/Akko_Keyboard_Scraper.py",
    "scrape:aula-keyboard": "python python/Aula_Keyboard_Scraper.py",
    "scrape:corsair-keyboard": "python python/Corsair_Keyboard_Scraper.py",
    "scrape:dareu-keyboard": "python python/DareU_Keyboard_Scraper.py",
    "scrape:flesports-keyboard": "python python/FLEsports_Keyboard_Scraper.py",
    "scrape:keychron-keyboard": "python python/Keychron_Keyboard_Scraper.py",
    "scrape:leobog-keyboard": "python python/Leobog_Keyboard_Scraper.py",
    "scrape:leopold-keyboard": "python python/Leopold_Keyboard_Scraper.py",
    "scrape:logitech-keyboard": "python python/Logitech_Keyboard_Scraper.py",
    "scrape:razer-keyboard": "python python/Razer_Keyboard_Scraper.py",
    "scrape:asus-mouse": "python python/Asus_Mouse_Scraper.py",
    "scrape:corsair-mouse": "python python/Corsair_Mouse_Scraper.py",
    "scrape:dareu-mouse": "python python/Dareu_Mouse_Scraper.py",
    "scrape:hyperx-mouse": "python python/Hyperx_Mouse_Scraper.py",
    "scrape:logitech-mouse": "python python/Logitech_Mouse_Scraper.py",
    "scrape:rapoo-mouse": "python python/Rapoo_Mouse_Scraper.py",
    "scrape:razer-mouse": "python python/Razer_Mouse_Scraper.py",
    "scrape:asus-headphone": "python python/Asus_Headphone_Scraper.py",
    "scrape:edifier-headphone": "python python/Edifier_Headphone_Scraper.py",
    "scrape:hyperx-headphone": "python python/Hyperx_Headphone_Scraper.py",
    "scrape:logitech-headphone": "python python/Logitech_Headphone_Scraper.py",
    "scrape:razer-headphone": "python python/Razer_Headphone_Scraper.py",
    "prepare:images": "python python/prepare_product_images.py"
  },
  "keywords": [],
