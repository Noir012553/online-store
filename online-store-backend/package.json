    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "unzipper": "^0.12.5",
